<UserControl x:Class="Loom.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:Loom.Views"
             Width="940"
             Height="640"
             FontFamily="{DynamicResource UiFontFamily}"
             FontSize="12.5"
             Foreground="{DynamicResource TextSecondaryBrush}"
             SnapsToDevicePixels="True"
             TextOptions.TextFormattingMode="Display">

    <Border x:Name="Chrome"
            Background="{DynamicResource L1Brush}"
            BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="1"
            CornerRadius="18">
        <Border.Effect>
            <DropShadowEffect BlurRadius="34" Color="#000000" Direction="270" Opacity="0.4" ShadowDepth="0" />
        </Border.Effect>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="208" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- ============ 左导航 ============ -->
            <Border Grid.Column="0" Background="{DynamicResource SidebarBrush}" CornerRadius="17,0,0,17">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <StackPanel Orientation="Horizontal" Margin="18,20,18,22"
                                MouseLeftButtonDown="OnHeaderMouseDown" Background="Transparent">
                        <views:LogoMark Width="30" Height="30" VerticalAlignment="Center" />
                        <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                            <TextBlock Style="{StaticResource BrandText}" Text="LOOM" />
                            <TextBlock Style="{StaticResource HintText}" Text="DSH 插件守护" Margin="0,1,0,0" />
                        </StackPanel>
                    </StackPanel>

                    <StackPanel Grid.Row="1" Margin="10,0">
                        <RadioButton x:Name="NavGeneral" GroupName="SettingsNav" Style="{StaticResource NavItem}"
                                     Tag="&#xE713;" Content="通用" Checked="OnNavChecked" />
                        <RadioButton x:Name="NavBackup" GroupName="SettingsNav" Style="{StaticResource NavItem}"
                                     Tag="&#xE81C;" Content="备份与还原" Margin="0,2,0,0" Checked="OnNavChecked" />
                        <RadioButton x:Name="NavCompat" GroupName="SettingsNav" Style="{StaticResource NavItem}"
                                     Tag="&#xE895;" Content="更新与兼容" Margin="0,2,0,0" Checked="OnNavChecked" />
                        <RadioButton x:Name="NavNotify" GroupName="SettingsNav" Style="{StaticResource NavItem}"
                                     Tag="&#xEA8F;" Content="通知" Margin="0,2,0,0" Checked="OnNavChecked" />
                        <RadioButton x:Name="NavStorage" GroupName="SettingsNav" Style="{StaticResource NavItem}"
                                     Tag="&#xE838;" Content="存储" Margin="0,2,0,0" Checked="OnNavChecked" />
                        <RadioButton x:Name="NavAbout" GroupName="SettingsNav" Style="{StaticResource NavItem}"
                                     Tag="&#xE946;" Content="关于" Margin="0,2,0,0" Checked="OnNavChecked" />
                    </StackPanel>

                    <Border Grid.Row="2" Margin="14,14,14,16" Padding="12" CornerRadius="12"
                            Background="{DynamicResource L2Brush}" BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="1">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Width="6" Height="6" Fill="{DynamicResource SuccessBrush}" VerticalAlignment="Center" />
                                <TextBlock Text="守护运行中" Margin="7,0,0,0" FontSize="11.5" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextPrimaryBrush}" />
                            </StackPanel>
                            <TextBlock Text="{Binding DshVersionText, StringFormat=DSH {0}}" Margin="0,5,0,0"
                                       Style="{StaticResource HintText}" />
                            <TextBlock Text="{Binding FrequencySummary}" Margin="0,1,0,0" Style="{StaticResource HintText}" />
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <!-- ============ 右侧内容 ============ -->
            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="44" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- 无边框窗口控制 -->
                <Grid Grid.Row="0" Background="Transparent" MouseLeftButtonDown="OnHeaderMouseDown">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center"
                                Margin="0,0,10,0">
                        <Button Style="{StaticResource IconButton}" Width="28" Height="28" Click="OnMinimizeClick" ToolTip="最小化">
                            <TextBlock Text="&#xE921;" FontFamily="{DynamicResource IconFontFamily}" FontSize="11"
                                       HorizontalAlignment="Center" Foreground="{DynamicResource TextTertiaryBrush}" />
                        </Button>
                        <Button Style="{StaticResource IconButton}" Width="28" Height="28" Margin="2,0,0,0"
                                Click="OnCloseClick" ToolTip="关闭">
                            <TextBlock Text="&#xE8BB;" FontFamily="{DynamicResource IconFontFamily}" FontSize="11"
                                       HorizontalAlignment="Center" Foreground="{DynamicResource TextTertiaryBrush}" />
                        </Button>
                    </StackPanel>
                </Grid>

                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                              Padding="28,0,28,0">
                    <Grid>
                        <!-- ===================== 通用 ===================== -->
                        <StackPanel x:Name="SectionGeneral">
                            <TextBlock Text="通用" Style="{StaticResource PageTitleText}" />
                            <TextBlock Text="主题、启动行为与数据目录" Style="{StaticResource SubText}" Margin="0,6,0,18" />

                            <Border Style="{StaticResource PaneCard}" Margin="0,0,0,14">
                                <StackPanel>
                                    <TextBlock Text="外观" Style="{StaticResource SectionTitleText}" />
                                    <TextBlock Text="深/浅两套 token 与 DSH 原生界面保持一致；跟随系统时读取 Windows 应用主题。"
                                               Style="{StaticResource RowHint}" Margin="0,5,0,12" />
                                    <StackPanel Orientation="Horizontal">
                                        <RadioButton Content="跟随系统" Style="{StaticResource ChipRadio}" Margin="0,0,8,0"
                                                     IsChecked="{Binding ThemeSystem, Mode=TwoWay}" />
                                        <RadioButton Content="深色" Style="{StaticResource ChipRadio}" Margin="0,0,8,0"
                                                     IsChecked="{Binding ThemeDark, Mode=TwoWay}" />
                                        <RadioButton Content="浅色" Style="{StaticResource ChipRadio}"
                                                     IsChecked="{Binding ThemeLight, Mode=TwoWay}" />
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource PaneCard}" Margin="0,0,0,14">
                                <StackPanel>
                                    <TextBlock Text="启动" Style="{StaticResource SectionTitleText}" />
                                    <Grid Margin="0,14,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="开机自启" Style="{StaticResource LabelText}" />
                                            <TextBlock Text="登录 Windows 后在通知区域后台运行（HKCU Run）。"
                                                       Style="{StaticResource RowHint}" Margin="0,3,0,0" />
                                        </StackPanel>
                                        <ToggleButton Grid.Column="1" Style="{StaticResource SwitchToggle}"
                                                      VerticalAlignment="Center" IsChecked="{Binding Autostart, Mode=TwoWay}" />
                                    </Grid>
                                    <Border Style="{StaticResource Divider}" Margin="0,14,0,14" />
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="启动后自动快照" Style="{StaticResource LabelText}" />
                                            <TextBlock Text="检测到 profile 变化且 DSH 稳定启动后，自动创建 light 快照。"
                                                       Style="{StaticResource RowHint}" Margin="0,3,0,0" />
                                        </StackPanel>
                                        <ToggleButton Grid.Column="1" Style="{StaticResource SwitchToggle}"
                                                      VerticalAlignment="Center"
                                                      IsChecked="{Binding AutoSnapshotOnStartup, Mode=TwoWay}" />
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource PaneCard}">
                                <StackPanel>
                                    <TextBlock Text="数据目录" Style="{StaticResource SectionTitleText}" />
                                    <TextBlock Text="快照、报告、日志与命令队列都位于此目录，默认 %LOCALAPPDATA%\Loom。"
                                               Style="{StaticResource RowHint}" Margin="0,5,0,10" />
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding DataRootText}" Style="{StaticResource ValueText}"
                                                   TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                        <Button Grid.Column="1" Command="{Binding OpenDataFolderCommand}"
                                                Style="{StaticResource SecondaryButton}" Height="30" Padding="12,0">
                                            <TextBlock Text="打开" FontSize="11.5" />
                                        </Button>
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!-- ===================== 备份与还原 ===================== -->
                        <StackPanel x:Name="SectionBackup" Visibility="Collapsed">
                            <TextBlock Text="备份与还原" Style="{StaticResource PageTitleText}" />
                            <TextBlock Text="快照策略与更新后的文件级还原" Style="{StaticResource SubText}" Margin="0,6,0,18" />

                            <Border Style="{StaticResource PaneCard}" Margin="0,0,0,14">
                                <StackPanel>
                                    <TextBlock Text="更新后自动恢复" Style="{StaticResource SectionTitleText}" />
                                    <Grid Margin="0,14,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="更新后自动文件级还原" Style="{StaticResource LabelText}" />
                                            <TextBlock Text="检测到强证据（插件被移除或补丁被重置）时，在 DSH 完全退出后自动把插件配置织回新运行时。"
                                                       Style="{StaticResource RowHint}" Margin="0,3,0,0" MaxWidth="560"
                                                       HorizontalAlignment="Left" />
                                        </StackPanel>
                                        <ToggleButton Grid.Column="1" Style="{StaticResource SwitchToggle}"
                                                      VerticalAlignment="Center"
                                                      IsChecked="{Binding AutoRestoreAfterRecovery, Mode=TwoWay}" />
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource PaneCard}" Margin="0,0,0,14">
                                <StackPanel>
                                    <TextBlock Text="快照与存储" Style="{StaticResource SectionTitleText}" />
                                    <Grid Margin="0,14,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="更新前完整快照" Style="{StaticResource LabelText}" />
                                            <TextBlock Text="检测到新版本安装包时采集含依赖闭包的完整快照（冻结，不参与常规清理）。"
                                                       Style="{StaticResource RowHint}" Margin="0,3,0,0" />
                                        </StackPanel>
                                        <ToggleButton Grid.Column="1" Style="{StaticResource SwitchToggle}"
                                                      VerticalAlignment="Center"
                                                      IsChecked="{Binding FullSnapshotOnUpdate, Mode=TwoWay}" />
                                    </Grid>

                                    <Border Style="{StaticResource Divider}" Margin="0,14,0,14" />

                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="保留份数" Style="{StaticResource LabelText}" />
                                            <TextBlock Text="超出后优先清理最旧的自动快照；每个运行时版本至少保留一份。"
                                                       Style="{StaticResource RowHint}" Margin="0,3,0,0" />
                                        </StackPanel>
                                        <ComboBox Grid.Column="1" Width="92" Style="{StaticResource LoomComboBox}"
                                                  ItemsSource="{Binding KeepOptions}" VerticalAlignment="Center"
                                                  SelectedItem="{Binding KeepSnapshotsText, Mode=TwoWay}" />
                                    </Grid>

                                    <Border Style="{StaticResource Divider}" Margin="0,14,0,14" />

                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="快照配额（GB）" Style="{StaticResource LabelText}" />
                                            <TextBlock Text="所有快照的总空间上限；超出后按保留策略清理。"
                                                       Style="{StaticResource RowHint}" Margin="0,3,0,0" />
                                        </StackPanel>
                                        <TextBox Grid.Column="1" Width="92" Style="{StaticResource LoomTextBox}"
                                                 VerticalAlignment="Center"
                                                 Text="{Binding QuotaGbText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                    </Grid>

                                    <Border Style="{StaticResource Divider}" Margin="0,14,0,14" />

                                    <Grid>
                                        <TextBlock Text="当前占用" Style="{StaticResource LabelText}" VerticalAlignment="Center" />
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                            <TextBlock Text="{Binding SnapshotSummaryText}" Style="{StaticResource ValueText}"
                                                       VerticalAlignment="Center" Margin="0,0,10,0" />
                                            <Button Command="{Binding OpenBackupFolderCommand}"
                                                    Style="{StaticResource SecondaryButton}" Height="30" Padding="12,0">
                                                <TextBlock Text="打开备份目录" FontSize="11.5" />
                                            </Button>
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource PaneCard}">
                                <StackPanel>
                                    <TextBlock Text="还原安全" Style="{StaticResource SectionTitleText}" />
                                    <TextBlock Margin="0,8,0,0" Style="{StaticResource RowHint}"
                                               Text="• 只写 desktop profile 的配置文件与依赖声明，不修改安装目录与 app.asar。&#10;• 应用前把现场完整备份到 restore-backup，可回滚。&#10;• 冲突项保留当前内容并写入报告，不做静默覆盖。" />
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!-- ===================== 更新与兼容 ===================== -->
                        <StackPanel x:Name="SectionCompat" Visibility="Collapsed">
                            <TextBlock Text="更新与兼容" Style="{StaticResource PageTitleText}" />
                            <TextBlock Text="决定 DSH 更新后如何处理旧插件" Style="{StaticResource SubText}" Margin="0,6,0,18" />

                            <!-- 应用更新（GitHub Releases 检查 / 下载 / 静默升级） -->
                            <Border Style="{StaticResource PaneCard}" Margin="0,0,0,14">
                                <StackPanel>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="应用更新" Style="{StaticResource SectionTitleText}" />
                                            <TextBlock Text="通过 GitHub Releases 检查并静默安装 Loom 新版本；安装版支持一键下载与重启更新。"
                                                       Style="{StaticResource RowHint}" Margin="0,5,0,0" MaxWidth="560"
                                                       HorizontalAlignment="Left" TextWrapping="Wrap" />
                                        </StackPanel>
                                        <TextBlock Grid.Column="1" Text="{Binding ToolVersionText, StringFormat=当前 {0}}"
                                                   Style="{StaticResource ValueText}" VerticalAlignment="Center" />
                                    </Grid>

                                    <Border Style="{StaticResource Divider}" Margin="0,12,0,12" />

                                    <TextBlock Text="{Binding UpdateStatusText}" Style="{StaticResource ValueText}" TextWrapping="Wrap" />
                                    <TextBlock Text="{Binding UpdateVersionText, StringFormat=最新版本：{0}}" Style="{StaticResource HintText}"
                                               Margin="0,3,0,0" />
                                    <ProgressBar Height="4" Margin="0,8,0,0" Style="{StaticResource LoomProgressBar}"
                                                 Minimum="0" Maximum="100" Value="{Binding UpdateProgress, Mode=OneWay}"
                                                 Visibility="{Binding ShowUpdateProgress, Converter={StaticResource BoolToVis}}" />
                                    <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                                        <Button Command="{Binding CheckUpdateCommand}" Style="{StaticResource SecondaryButton}"
                                                Height="30" Padding="12,0">
                                            <TextBlock Text="{Binding UpdateActionText}" FontSize="11.5" />
                                        </Button>
                                        <Button Command="{Binding DownloadUpdateCommand}" Style="{StaticResource PrimaryButton}"
                                                Height="30" Padding="12,0" Margin="8,0,0,0"
                                                Visibility="{Binding ShowDownloadUpdate, Converter={StaticResource BoolToVis}}">
                                            <TextBlock Text="下载更新" FontSize="11.5" />
                                        </Button>
                                        <Button Command="{Binding ApplyUpdateCommand}" Style="{StaticResource PrimaryButton}"
                                                Height="30" Padding="12,0" Margin="8,0,0,0"
                                                Visibility="{Binding ShowApplyUpdate, Converter={StaticResource BoolToVis}}">
                                            <TextBlock Text="重启并更新" FontSize="11.5" />
                                        </Button>
                                        <Button Command="{Binding OpenReleasePageCommand}" Style="{StaticResource SecondaryButton}"
                                                Height="30" Padding="12,0" Margin="8,0,0,0">
                                            <TextBlock Text="打开发布页" FontSize="11.5" />
                                        </Button>
                                    </StackPanel>

                                    <TextBlock Text="{Binding UpdateErrorText}" Foreground="{DynamicResource DangerBrush}"
                                               FontSize="11.5" Margin="0,8,0,0" TextWrapping="Wrap"
                                               Visibility="{Binding HasUpdateError, Converter={StaticResource BoolToVis}}" />

                                    <Border Style="{StaticResource Divider}" Margin="0,14,0,12" />

                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="自动检查更新" Style="{StaticResource LabelText}" />
                                            <TextBlock Text="启动后每 24 小时最多检查一次 GitHub Releases；失败也会计入间隔。"
                                                       Style="{StaticResource RowHint}" Margin="0,3,0,0" />
                                        </StackPanel>
                                        <ToggleButton Grid.Column="1" Style="{StaticResource SwitchToggle}"
                                                      VerticalAlignment="Center"
                                                      IsChecked="{Binding AutoCheckUpdate, Mode=TwoWay}" />
                                    </Grid>
                                    <Grid Margin="0,10,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="升级后删除安装包" Style="{StaticResource LabelText}" />
                                            <TextBlock Text="静默升级成功后的首次启动，删除下载目录里的安装包。"
                                                       Style="{StaticResource RowHint}" Margin="0,3,0,0" />
                                        </StackPanel>
                                        <ToggleButton Grid.Column="1" Style="{StaticResource SwitchToggle}"
                                                      VerticalAlignment="Center"
                                                      IsChecked="{Binding DeleteSetupAfterUpdate, Mode=TwoWay}" />
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource PaneCard}" Margin="0,0,0,14">
                                <StackPanel>
                                    <TextBlock Text="兼容性处理" Style="{StaticResource SectionTitleText}" />
                                    <StackPanel Margin="0,14,0,0">
                                        <RadioButton GroupName="CompatPolicy" Style="{StaticResource LoomRadio}"
                                                     IsChecked="{Binding PolicyAutoUpgrade, Mode=TwoWay}">
                                            <StackPanel>
                                                <TextBlock Text="自动升级到兼容版本（推荐）" Style="{StaticResource LabelText}" />
                                                <TextBlock Text="发现不兼容插件时查询兼容版本并升级（本版仅执行检查与提示）。"
                                                           Style="{StaticResource RowHint}" Margin="0,2,0,0" />
                                            </StackPanel>
                                        </RadioButton>
                                        <RadioButton GroupName="CompatPolicy" Style="{StaticResource LoomRadio}" Margin="0,12,0,0"
                                                     IsChecked="{Binding PolicyNotifyOnly, Mode=TwoWay}">
                                            <StackPanel>
                                                <TextBlock Text="仅提示，不自动处理" Style="{StaticResource LabelText}" />
                                                <TextBlock Text="兼容性问题只写入报告与通知，由你手动处理。"
                                                           Style="{StaticResource RowHint}" Margin="0,2,0,0" />
                                            </StackPanel>
                                        </RadioButton>
                                        <RadioButton GroupName="CompatPolicy" Style="{StaticResource LoomRadio}" Margin="0,12,0,0"
                                                     IsChecked="{Binding PolicyKeepOld, Mode=TwoWay}">
                                            <StackPanel>
                                                <TextBlock Text="保留旧版并风险豁免（需确认）" Style="{StaticResource LabelText}" />
                                                <TextBlock Text="为插件写入精确版本豁免；仅在你确认风险后使用。"
                                                           Style="{StaticResource RowHint}" Margin="0,2,0,0" />
                                            </StackPanel>
                                        </RadioButton>
                                    </StackPanel>
                                    <TextBlock Text="兼容结果写入报告，需人工确认的项会出现在托盘状态与通知中；自动安装只在“策略 A 自动升级”打开后生效。"
                                               Style="{StaticResource RowHint}" Margin="0,14,0,0" TextWrapping="Wrap" MaxWidth="560"
                                               HorizontalAlignment="Left" />
                                </StackPanel>
                            </Border>

                            <!-- 二期：策略 A 自动升级（插件） -->
                            <Border Style="{StaticResource PaneCard}" Margin="0,0,0,14">
                                <StackPanel>
                                    <TextBlock Text="插件自动升级（策略 A）" Style="{StaticResource SectionTitleText}" />
                                    <TextBlock Text="只在 DSH 完全退出后执行：查询与目标运行时兼容的版本并安装（--save-exact），写前先备份到 restore-backup；没有兼容版本时只提示，不自动豁免风险。"
                                               Style="{StaticResource RowHint}" Margin="0,6,0,0" TextWrapping="Wrap" MaxWidth="560"
                                               HorizontalAlignment="Left" />

                                    <Grid Margin="0,14,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="策略 A 自动升级" Style="{StaticResource LabelText}" />
                                            <TextBlock Text="{Binding AutoUpgradeHintText, Mode=OneWay}"
                                                       Style="{StaticResource RowHint}" Margin="0,3,0,0" TextWrapping="Wrap"
                                                       MaxWidth="540" HorizontalAlignment="Left" />
                                        </StackPanel>
                                        <ToggleButton Grid.Column="1" Style="{StaticResource SwitchToggle}"
                                                      VerticalAlignment="Center"
                                                      IsChecked="{Binding AutoUpgradeEnabled, Mode=TwoWay}" />
                                    </Grid>

                                    <Grid Margin="0,10,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="允许 major 升级" Style="{StaticResource LabelText}" />
                                            <TextBlock Text="允许跨大版本升级；可能涉及插件数据格式迁移，建议先快照。"
                                                       Style="{StaticResource RowHint}" Margin="0,3,0,0" TextWrapping="Wrap"
                                                       MaxWidth="540" HorizontalAlignment="Left" />
                                        </StackPanel>
                                        <ToggleButton Grid.Column="1" Style="{StaticResource SwitchToggle}"
                                                      VerticalAlignment="Center"
                                                      IsChecked="{Binding AllowMajorUpgrade, Mode=TwoWay}" />
                                    </Grid>

                                    <Grid Margin="0,10,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="允许预发布版本" Style="{StaticResource LabelText}" />
                                            <TextBlock Text="允许 nightly / next 等预发布候选（仍稳定版优先；只有没有稳定兼容版本时才会选中）。"
                                                       Style="{StaticResource RowHint}" Margin="0,3,0,0" TextWrapping="Wrap"
                                                       MaxWidth="540" HorizontalAlignment="Left" />
                                        </StackPanel>
                                        <ToggleButton Grid.Column="1" Style="{StaticResource SwitchToggle}"
                                                      VerticalAlignment="Center"
                                                      IsChecked="{Binding AllowPrereleaseUpgrade, Mode=TwoWay}" />
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!-- 更新后自动恢复只保留“备份与还原”页的一处（P3：同一开关曾被重复绑定两处）。
                                 这里不再放第二张卡片，避免同一配置项两个开关、说明文案还互相矛盾。 -->

                            <!-- 二期：包级恢复（package.json + pnpm-lock.yaml + 离线 install） -->
                            <Border Style="{StaticResource PaneCard}" Margin="0,14,0,0">
                                <StackPanel>
                                    <TextBlock Text="包级恢复（实验性）" Style="{StaticResource SectionTitleText}" />
                                    <!-- P3：属性值必须是单行。XAML 会原样保留属性值内的换行+缩进，
                                         一旦为了排版折行，渲染后句子中间就会出现一大段空白。 -->
                                    <TextBlock Text="文件级还原救不回 node_modules：包级恢复会先备份两个核心文件，再按快照写回 package.json / pnpm-lock.yaml，用 dsh plugin install --offline --frozen-lockfile 重建依赖树并校验；失败只回滚本次操作。"
                                               Style="{StaticResource RowHint}" Margin="0,6,0,0" TextWrapping="Wrap" MaxWidth="560"
                                               HorizontalAlignment="Left" />

                                    <Grid Margin="0,14,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="启用包级恢复" Style="{StaticResource LabelText}" />
                                            <TextBlock Text="{Binding PackageRestoreHintText, Mode=OneWay}"
                                                       Style="{StaticResource RowHint}" Margin="0,3,0,0" TextWrapping="Wrap"
                                                       MaxWidth="540" HorizontalAlignment="Left" />
                                        </StackPanel>
                                        <ToggleButton Grid.Column="1" Style="{StaticResource SwitchToggle}"
                                                      VerticalAlignment="Center"
                                                      IsChecked="{Binding PackageRestoreEnabled, Mode=TwoWay}" />
                                    </Grid>

                                    <Grid Margin="0,10,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="允许联网回退" Style="{StaticResource LabelText}" />
                                            <TextBlock Text="离线安装缺缓存时允许“询问”是否联网重试；仍需每次确认，默认只走离线。"
                                                       Style="{StaticResource RowHint}" Margin="0,3,0,0" TextWrapping="Wrap"
                                                       MaxWidth="540" HorizontalAlignment="Left" />
                                        </StackPanel>
                                        <ToggleButton Grid.Column="1" Style="{StaticResource SwitchToggle}"
                                                      VerticalAlignment="Center"
                                                      IsChecked="{Binding PackageRestoreAllowNetworkFallback, Mode=TwoWay}" />
                                    </Grid>

                                    <Border Style="{StaticResource Divider}" Margin="0,14,0,12" />

                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="回滚上一次包级操作" Style="{StaticResource LabelText}" />
                                            <TextBlock Text="{Binding RollbackHintText, Mode=OneWay}"
                                                       Style="{StaticResource RowHint}" Margin="0,3,0,0" TextWrapping="Wrap"
                                                       MaxWidth="540" HorizontalAlignment="Left" />
                                        </StackPanel>
                                        <Button Grid.Column="1" Command="{Binding RollbackPackageCommand}"
                                                IsEnabled="{Binding CanRollbackPackage, Mode=OneWay}"
                                                Style="{StaticResource SecondaryButton}" Height="30" Padding="12,0"
                                                VerticalAlignment="Center">
                                            <TextBlock Text="回滚" FontSize="11.5" />
                                        </Button>
                                    </Grid>

                                    <TextBlock Text="{Binding RollbackStatusText, Mode=OneWay}"
                                               Foreground="{DynamicResource DangerBrush}" FontSize="11.5" Margin="0,8,0,0"
                                               TextWrapping="Wrap"
                                               Visibility="{Binding HasRollbackStatus, Converter={StaticResource BoolToVis}}" />

                                    <TextBlock Text="需要 DSH 完全退出；Loom 不会结束进程、不会联网重试、不会写安装目录或 app.asar。"
                                               Style="{StaticResource RowHint}" Margin="0,10,0,0" TextWrapping="Wrap" MaxWidth="560"
                                               HorizontalAlignment="Left" />
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!-- ===================== 通知 ===================== -->
                        <StackPanel x:Name="SectionNotify" Visibility="Collapsed">
                            <TextBlock Text="通知" Style="{StaticResource PageTitleText}" />
                            <TextBlock Text="气泡通知与夜间静默" Style="{StaticResource SubText}" Margin="0,6,0,18" />

                            <Border Style="{StaticResource PaneCard}" Margin="0,0,0,14">
                                <StackPanel>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="气泡通知" Style="{StaticResource LabelText}" />
                                            <TextBlock Text="快照完成、发现新版、兼容检查需人工处理时发送 Windows 气泡通知。"
                                                       Style="{StaticResource RowHint}" Margin="0,3,0,0" />
                                        </StackPanel>
                                        <ToggleButton Grid.Column="1" Style="{StaticResource SwitchToggle}"
                                                      VerticalAlignment="Center"
                                                      IsChecked="{Binding Notifications, Mode=TwoWay}" />
                                    </Grid>

                                    <Border Style="{StaticResource Divider}" Margin="0,14,0,14" />

                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="静默时段" Style="{StaticResource LabelText}" />
                                            <TextBlock Text="静默时段内不弹气泡，但事件仍记录在最近活动与报告中。"
                                                       Style="{StaticResource RowHint}" Margin="0,3,0,0" />
                                        </StackPanel>
                                        <ToggleButton Grid.Column="1" Style="{StaticResource SwitchToggle}"
                                                      VerticalAlignment="Center"
                                                      IsChecked="{Binding QuietHoursEnabled, Mode=TwoWay}" />
                                    </Grid>

                                    <Grid Margin="0,14,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="起止时间" Style="{StaticResource LabelText}" VerticalAlignment="Center" />
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" IsEnabled="{Binding QuietHoursEnabled}">
                                            <TextBox Width="78" Style="{StaticResource LoomTextBox}"
                                                     Text="{Binding QuietHoursStart, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                            <TextBlock Text="至" Style="{StaticResource ValueText}" Margin="8,0" VerticalAlignment="Center" />
                                            <TextBox Width="78" Style="{StaticResource LoomTextBox}"
                                                     Text="{Binding QuietHoursEnd, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource PaneCard}">
                                <StackPanel>
                                    <TextBlock Text="通知方式说明" Style="{StaticResource SectionTitleText}" />
                                    <TextBlock Margin="0,8,0,0" Style="{StaticResource RowHint}"
                                               Text="首版使用 NotifyIcon 气泡通知（未签名 exe 最可靠，4 秒自动消失）。&#10;点击通知会打开对应的报告；同一事件只通知一次。&#10;Windows Toast（需要快捷方式与 AppUserModelID）在二期启用。" />
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!-- ===================== 存储 ===================== -->
                        <StackPanel x:Name="SectionStorage" Visibility="Collapsed">
                            <TextBlock Text="存储" Style="{StaticResource PageTitleText}" />
                            <TextBlock Text="数据、报告与日志位置" Style="{StaticResource SubText}" Margin="0,6,0,18" />

                            <Border Style="{StaticResource PaneCard}" Margin="0,0,0,14">
                                <StackPanel>
                                    <TextBlock Text="位置" Style="{StaticResource SectionTitleText}" />
                                    <Grid Margin="0,14,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="112" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="数据目录" Style="{StaticResource LabelText}" VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="1" Text="{Binding DataRootText}" Style="{StaticResource ValueText}"
                                                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                        <Button Grid.Column="2" Command="{Binding OpenDataFolderCommand}"
                                                Style="{StaticResource SecondaryButton}" Height="30" Padding="12,0">
                                            <TextBlock Text="打开" FontSize="11.5" />
                                        </Button>
                                    </Grid>
                                    <Grid Margin="0,10,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="112" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="配置文件" Style="{StaticResource LabelText}" VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="1" Text="{Binding ConfigPathText}" Style="{StaticResource ValueText}"
                                                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                    </Grid>
                                    <Grid Margin="0,10,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="112" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="日志目录" Style="{StaticResource LabelText}" VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="1" Text="{Binding LogsPathText}" Style="{StaticResource ValueText}"
                                                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                        <Button Grid.Column="2" Command="{Binding OpenLogsFolderCommand}"
                                                Style="{StaticResource SecondaryButton}" Height="30" Padding="12,0">
                                            <TextBlock Text="打开日志" FontSize="11.5" />
                                        </Button>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource PaneCard}" Margin="0,0,0,14">
                                <StackPanel>
                                    <TextBlock Text="快照占用" Style="{StaticResource SectionTitleText}" />
                                    <Grid Margin="0,14,0,0">
                                        <TextBlock Text="{Binding SnapshotSummaryText}" Style="{StaticResource ValueText}"
                                                   VerticalAlignment="Center" />
                                        <Button HorizontalAlignment="Right" Command="{Binding OpenBackupFolderCommand}"
                                                Style="{StaticResource SecondaryButton}" Height="30" Padding="12,0">
                                            <TextBlock Text="打开备份目录" FontSize="11.5" />
                                        </Button>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource PaneCard}">
                                <StackPanel>
                                    <TextBlock Text="范围" Style="{StaticResource SectionTitleText}" />
                                    <TextBlock Margin="0,8,0,0" Style="{StaticResource RowHint}"
                                               Text="• 只守护 DSH desktop profile；检测到 profiles\web 时只说明不处理、不读取内容。&#10;• 不读取凭据文件（.credentials.yaml / DPAPI），不写入安装目录。&#10;• 安装路径或 DSH_HOME 变化时可用“重新定位”刷新。" />
                                    <Button HorizontalAlignment="Left" Margin="0,12,0,0" Command="{Binding RelocateCommand}"
                                            Style="{StaticResource SecondaryButton}" Height="30" Padding="12,0">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="&#xE895;" FontFamily="{DynamicResource IconFontFamily}" FontSize="11"
                                                       VerticalAlignment="Center" />
                                            <TextBlock Text="重新定位 DSH" Margin="6,0,0,0" FontSize="11.5" />
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!-- ===================== 关于 ===================== -->
                        <StackPanel x:Name="SectionAbout" Visibility="Collapsed">
                            <TextBlock Text="关于 Loom for DSH" Style="{StaticResource PageTitleText}" />
                            <TextBlock Text="更新再多，插件都在。" Style="{StaticResource SubText}" Margin="0,6,0,18" />

                            <Border Style="{StaticResource PaneCard}" Margin="0,0,0,14">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <views:LogoMark Width="44" Height="44" VerticalAlignment="Center" />
                                        <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                                            <TextBlock Style="{StaticResource BrandText}" Text="LOOM" FontSize="18" />
                                            <TextBlock Text="DSH 插件守护 · 绿色免安装工具" Style="{StaticResource HintText}" Margin="0,2,0,0" />
                                        </StackPanel>
                                    </StackPanel>
                                    <Border Style="{StaticResource Divider}" Margin="0,16,0,6" />
                                    <Grid Margin="0,8,0,0">
                                        <TextBlock Text="工具版本" Style="{StaticResource ValueText}" />
                                        <TextBlock Text="{Binding ToolVersionText}" HorizontalAlignment="Right" Style="{StaticResource ValueText}" />
                                    </Grid>
                                    <Grid Margin="0,8,0,0">
                                        <TextBlock Text="应用版本" Style="{StaticResource ValueText}" />
                                        <TextBlock Text="{Binding AppVersionText}" HorizontalAlignment="Right" Style="{StaticResource ValueText}" />
                                    </Grid>
                                    <Grid Margin="0,8,0,0">
                                        <TextBlock Text="运行时版本" Style="{StaticResource ValueText}" />
                                        <TextBlock Text="{Binding DshVersionText}" HorizontalAlignment="Right" Style="{StaticResource ValueText}" />
                                    </Grid>
                                    <Grid Margin="0,8,0,0">
                                        <TextBlock Text="数据目录" Style="{StaticResource ValueText}" />
                                        <TextBlock Text="{Binding DataRootText}" HorizontalAlignment="Right" Style="{StaticResource ValueText}"
                                                   TextTrimming="CharacterEllipsis" MaxWidth="420" />
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource PaneCard}">
                                <StackPanel>
                                    <TextBlock Text="说明" Style="{StaticResource SectionTitleText}" />
                                    <TextBlock Margin="0,8,0,0" Style="{StaticResource RowHint}"
                                               Text="Loom 在本地记录插件状态并在 DSH 更新后把插件重新织回新运行时；不会联网（首版）、不修改安装目录、不读取凭据。&#10;失败时可用最近报告中的重试与回滚入口恢复。" />
                                    <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                                        <Button Command="{Binding OpenDataFolderCommand}" Style="{StaticResource SecondaryButton}"
                                                Height="30" Padding="12,0">
                                            <TextBlock Text="打开数据目录" FontSize="11.5" />
                                        </Button>
                                        <Button Command="{Binding OpenLogsFolderCommand}" Style="{StaticResource SecondaryButton}"
                                                Height="30" Padding="12,0" Margin="8,0,0,0">
                                            <TextBlock Text="打开日志目录" FontSize="11.5" />
                                        </Button>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Grid>
                </ScrollViewer>

                <!-- 底部操作条 -->
                <Border x:Name="FooterBar" Grid.Row="2" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0" Padding="22,12">
                    <Grid>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="{Binding ErrorText}" Foreground="{DynamicResource DangerBrush}" FontSize="11.5"
                                       VerticalAlignment="Center"
                                       Visibility="{Binding HasError, Converter={StaticResource BoolToVis}}" />
                            <StackPanel Orientation="Horizontal"
                                        Visibility="{Binding HasSavedHint, Converter={StaticResource BoolToVis}}">
                                <TextBlock Text="&#xE73E;" FontFamily="{DynamicResource IconFontFamily}" FontSize="11"
                                           Foreground="{DynamicResource SuccessBrush}" VerticalAlignment="Center" />
                                <TextBlock Text="{Binding SavedHint}" Foreground="{DynamicResource SuccessBrush}"
                                           FontSize="11.5" Margin="6,0,0,0" VerticalAlignment="Center" />
                            </StackPanel>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Command="{Binding CancelCommand}" Style="{StaticResource SecondaryButton}"
                                    Height="36" Padding="18,0">
                                <TextBlock Text="取消" FontSize="12" />
                            </Button>
                            <Button Command="{Binding SaveCommand}" Style="{StaticResource PrimaryButton}"
                                    Height="36" Padding="22,0" Margin="10,0,0,0">
                                <TextBlock Text="{Binding SaveText}" FontSize="12.5" />
                            </Button>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Border>
</UserControl>
