<UserControl x:Class="Loom.Views.ReportView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:Loom.Views"
             Width="860"
             Height="640"
             FontFamily="{DynamicResource UiFontFamily}"
             FontSize="12.5"
             Foreground="{DynamicResource TextSecondaryBrush}"
             SnapsToDevicePixels="True"
             TextOptions.TextFormattingMode="Display">

    <Border Background="{DynamicResource L1Brush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
            CornerRadius="18">
        <Border.Effect>
            <DropShadowEffect BlurRadius="34" Color="#000000" Direction="270" Opacity="0.4" ShadowDepth="0" />
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="44" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- 顶部栏 -->
            <Grid Grid.Row="0" Margin="22,0,10,0" Background="Transparent" MouseLeftButtonDown="OnHeaderMouseDown">
                <TextBlock Text="操作报告" Style="{StaticResource SectionTitleText}" VerticalAlignment="Center" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Button Style="{StaticResource IconButton}" Width="28" Height="28" Click="OnMinimizeClick" ToolTip="最小化">
                        <TextBlock Text="&#xE921;" FontFamily="{DynamicResource IconFontFamily}" FontSize="11"
                                   HorizontalAlignment="Center" Foreground="{DynamicResource TextTertiaryBrush}" />
                    </Button>
                    <Button Style="{StaticResource IconButton}" Width="28" Height="28" Margin="2,0,0,0"
                            Click="OnCloseClick" ToolTip="关闭">
                        <TextBlock Text="&#xE8BB;" FontFamily="{DynamicResource IconFontFamily}" FontSize="11"
                                   HorizontalAlignment="Center" Foreground="{DynamicResource TextTertiaryBrush}" />
                    </Button>
                </StackPanel>
            </Grid>

            <Grid Grid.Row="1" Margin="24,0,24,18">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0">
                    <TextBlock Text="最近一次操作报告" Style="{StaticResource PageTitleText}" FontSize="19" />
                    <TextBlock Text="报告同时以 JSON 与 Markdown 写入数据目录，不含凭据与补丁内容。"
                               Style="{StaticResource SubText}" Margin="0,5,0,0" />
                </StackPanel>

                <!-- 工具条 -->
                <Grid Grid.Row="1" Margin="0,14,0,0">
                    <StackPanel Orientation="Horizontal">
                        <Button Command="{Binding RefreshCommand}" Style="{StaticResource SecondaryButton}"
                                Height="32" Padding="12,0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE895;" FontFamily="{DynamicResource IconFontFamily}" FontSize="11"
                                           VerticalAlignment="Center" />
                                <TextBlock Text="刷新" Margin="6,0,0,0" FontSize="11.5" />
                            </StackPanel>
                        </Button>
                        <Button Command="{Binding CopyPathCommand}" Style="{StaticResource SecondaryButton}"
                                Height="32" Padding="12,0" Margin="8,0,0,0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE8C8;" FontFamily="{DynamicResource IconFontFamily}" FontSize="11"
                                           VerticalAlignment="Center" />
                                <TextBlock Text="复制路径" Margin="6,0,0,0" FontSize="11.5" />
                            </StackPanel>
                        </Button>
                        <Button Command="{Binding OpenExternalCommand}" Style="{StaticResource SecondaryButton}"
                                Height="32" Padding="12,0" Margin="8,0,0,0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE8E5;" FontFamily="{DynamicResource IconFontFamily}" FontSize="11"
                                           VerticalAlignment="Center" />
                                <TextBlock Text="用默认程序打开" Margin="6,0,0,0" FontSize="11.5" />
                            </StackPanel>
                        </Button>
                        <Button Command="{Binding OpenReportsFolderCommand}" Style="{StaticResource GhostButton}"
                                Height="32" Padding="10,0" Margin="4,0,0,0">
                            <TextBlock Text="打开报告目录" FontSize="11.5" />
                        </Button>
                    </StackPanel>
                </Grid>

                <!-- 失败 / 人工入口 -->
                <Border Grid.Row="2" Margin="0,12,0,0" CornerRadius="12" Padding="12,10"
                        Background="{DynamicResource WarningSoftBrush}">
                    <Grid>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="&#xE7BA;" FontFamily="{DynamicResource IconFontFamily}" FontSize="13"
                                       Foreground="{DynamicResource WarningBrush}" VerticalAlignment="Center" />
                            <TextBlock Text="需要人工处理时：先完全退出 DSH，再重试检查或回滚到最近快照。"
                                       Margin="8,0,0,0" FontSize="11.5" Foreground="{DynamicResource TextSecondaryBrush}"
                                       VerticalAlignment="Center" TextWrapping="Wrap" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Command="{Binding RetryCommand}" Style="{StaticResource SecondaryButton}"
                                    Height="30" Padding="12,0">
                                <TextBlock Text="重试检查" FontSize="11.5" />
                            </Button>
                            <Button Command="{Binding RollbackCommand}" Style="{StaticResource SecondaryButton}"
                                    Height="30" Padding="12,0" Margin="6,0,0,0">
                                <TextBlock Text="回滚" FontSize="11.5" />
                            </Button>
                            <Button Command="{Binding OpenPluginManagerCommand}" Style="{StaticResource GhostButton}"
                                    Height="30" Padding="10,0" Margin="4,0,0,0">
                                <TextBlock Text="打开插件管理器" FontSize="11.5" />
                            </Button>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- 报告正文 -->
                <Grid Grid.Row="3" Margin="0,12,0,0">
                    <Border Style="{StaticResource InsetCard}" Padding="0">
                        <Grid>
                            <TextBox Text="{Binding Markdown, Mode=OneWay}" IsReadOnly="True" AcceptsReturn="True"
                                     TextWrapping="Wrap" Background="Transparent" BorderThickness="0" Padding="16,14"
                                     VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                                     FontFamily="{DynamicResource MonoFontFamily}" FontSize="11.5"
                                     Foreground="{DynamicResource TextSecondaryBrush}"
                                     SelectionBrush="{DynamicResource AccentBrush}" />
                            <TextBlock Text="{Binding EmptyText}" Style="{StaticResource SubText}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="12"
                                       Visibility="{Binding HasNoReport, Converter={StaticResource BoolToVis}}" />
                        </Grid>
                    </Border>
                </Grid>

                <!-- 状态栏 -->
                <Grid Grid.Row="4" Margin="0,10,0,0">
                    <TextBlock Text="{Binding PathText}" Style="{StaticResource HintText}" FontSize="10.5"
                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,0,12,0" />
                    <TextBlock Text="{Binding StatusText}" HorizontalAlignment="Right" FontSize="11"
                               VerticalAlignment="Center">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="{DynamicResource TextTertiaryBrush}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding StatusIsError}" Value="True">
                                        <Setter Property="Foreground" Value="{DynamicResource DangerBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Grid>
            </Grid>
        </Grid>
    </Border>
</UserControl>
