<UserControl x:Class="Loom.Views.TrayMenuView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Width="232"
             FontFamily="{DynamicResource MenuFontFamily}"
             FontSize="14"
             Foreground="{DynamicResource MenuTextBrush}"
             SnapsToDevicePixels="True"
             TextOptions.TextFormattingMode="Display"
             UseLayoutRounding="True">
    <!--
        托盘右键菜单（WPF 自绘，跟随 Loom 应用主题 token）。
        几何/交互参考 DeskOrder 的托盘右键：10px 圆角 · 1px 细边 · 36px 行高 ·
        16px 图标列 · 4px 圆角 hover · 贯穿分割线 · 14px Segoe UI Variable Text ·
        淡入 + 轻阴影（淡入由 TrayMenuWindow 负责）。窗口透明，这里只画卡片。
    -->
    <UserControl.Resources>
        <!-- 菜单行：透明底 + 4px 圆角 hover；禁用/危险项的着色在 DataTemplate 触发器里 -->
        <Style x:Key="TrayMenuRow" TargetType="Button">
            <Setter Property="Height" Value="36" />
            <Setter Property="Margin" Value="2,1" />
            <Setter Property="Padding" Value="10,0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="{DynamicResource MenuTextBrush}" />
            <Setter Property="FontFamily" Value="{DynamicResource MenuFontFamily}" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Cursor" Value="Arrow" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                CornerRadius="4"
                                SnapsToDevicePixels="True">
                            <ContentPresenter Margin="{TemplateBinding Padding}"
                                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource MenuHoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource MenuPressedBrush}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource MenuHoverBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Border x:Name="Card"
            Background="{DynamicResource MenuSurfaceBrush}"
            BorderBrush="{DynamicResource MenuBorderBrush}"
            BorderThickness="1"
            CornerRadius="10"
            Padding="4">
        <Border.Effect>
            <DropShadowEffect BlurRadius="22" Color="#000000" Direction="270" Opacity="0.35" ShadowDepth="2" />
        </Border.Effect>

        <ItemsControl x:Name="ItemsHost"
                      ItemsSource="{Binding Items}"
                      Focusable="False"
                      KeyboardNavigation.DirectionalNavigation="Contained">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Grid>
                        <Button x:Name="Row"
                                Style="{StaticResource TrayMenuRow}"
                                IsEnabled="{Binding IsEnabled}"
                                Click="OnItemClick">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <!-- 16px 图标列（DeskOrder 为 24px，这里按 Loom 更紧凑的菜单收窄） -->
                                    <ColumnDefinition Width="16" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Name="Glyph"
                                           Text="{Binding Glyph}"
                                           FontFamily="{DynamicResource IconFontFamily}"
                                           FontSize="13"
                                           Foreground="{DynamicResource MenuIconBrush}"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center" />
                                <TextBlock Grid.Column="1"
                                           Text="{Binding Text}"
                                           Margin="12,0,2,0"
                                           VerticalAlignment="Center"
                                           TextTrimming="CharacterEllipsis" />
                            </Grid>
                        </Button>
                        <!-- 贯穿式分割线：负边距抵消卡片 Padding=4，左右顶到外框 -->
                        <Border x:Name="Sep"
                                Height="1"
                                Margin="-4,4"
                                Background="{DynamicResource MenuSeparatorBrush}"
                                SnapsToDevicePixels="True"
                                Visibility="Collapsed" />
                    </Grid>
                    <DataTemplate.Triggers>
                        <DataTrigger Binding="{Binding IsSeparator}" Value="True">
                            <Setter TargetName="Row" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="Sep" Property="Visibility" Value="Visible" />
                        </DataTrigger>
                        <!-- 危险项（退出）：弱化危险色，只给图标与文字着色 -->
                        <DataTrigger Binding="{Binding IsDanger}" Value="True">
                            <Setter TargetName="Row" Property="Foreground" Value="{DynamicResource MenuDangerBrush}" />
                            <Setter TargetName="Glyph" Property="Foreground" Value="{DynamicResource MenuDangerBrush}" />
                        </DataTrigger>
                        <!-- 禁用：只弱化前景，保留占位（忙碌时快照/检查不可用） -->
                        <DataTrigger Binding="{Binding IsEnabled}" Value="False">
                            <Setter TargetName="Row" Property="Foreground" Value="{DynamicResource MenuTextDisabledBrush}" />
                            <Setter TargetName="Glyph" Property="Foreground" Value="{DynamicResource MenuTextDisabledBrush}" />
                        </DataTrigger>
                    </DataTemplate.Triggers>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </Border>
</UserControl>
