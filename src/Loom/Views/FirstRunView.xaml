<UserControl x:Class="Loom.Views.FirstRunView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:Loom.Views"
             Width="720"
             Height="660"
             FontFamily="{DynamicResource UiFontFamily}"
             FontSize="12.5"
             Foreground="{DynamicResource TextSecondaryBrush}"
             SnapsToDevicePixels="True"
             TextOptions.TextFormattingMode="Display">

    <Border Background="{DynamicResource L1Brush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
            CornerRadius="18">
        <Border.Effect>
            <DropShadowEffect BlurRadius="34" Color="#000000" Direction="270" Opacity="0.4" ShadowDepth="0" />
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="26,16,20,0" Background="Transparent" MouseLeftButtonDown="OnHeaderMouseDown">
                <StackPanel Orientation="Horizontal">
                    <views:LogoMark Width="30" Height="30" VerticalAlignment="Center" />
                    <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                        <TextBlock Style="{StaticResource BrandText}" Text="LOOM" />
                        <TextBlock Style="{StaticResource HintText}" Text="DSH 插件守护 · 首次运行" Margin="0,1,0,0" />
                    </StackPanel>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Button Style="{StaticResource IconButton}" Width="28" Height="28" Click="OnMinimizeClick" ToolTip="最小化">
                        <TextBlock Text="&#xE921;" FontFamily="{DynamicResource IconFontFamily}" FontSize="11"
                                   HorizontalAlignment="Center" Foreground="{DynamicResource TextTertiaryBrush}" />
                    </Button>
                    <Button Style="{StaticResource IconButton}" Width="28" Height="28" Margin="2,0,0,0"
                            Click="OnCloseClick" ToolTip="关闭">
                        <TextBlock Text="&#xE8BB;" FontFamily="{DynamicResource IconFontFamily}" FontSize="11"
                                   HorizontalAlignment="Center" Foreground="{DynamicResource TextTertiaryBrush}" />
                    </Button>
                </StackPanel>
            </Grid>

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                          Padding="26,6,26,0">
                <StackPanel>
                    <TextBlock Text="欢迎使用 Loom" Style="{StaticResource PageTitleText}" />
                    <TextBlock Text="用一次快照，把插件织回每一次 DSH 更新。" Style="{StaticResource SubText}"
                               Margin="0,5,0,12" />

                    <Border Style="{StaticResource PaneCard}" Margin="0,0,0,10">
                        <StackPanel>
                            <TextBlock Text="保护范围" Style="{StaticResource SectionTitleText}" />
                            <Grid Margin="0,10,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="20" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="&#xE73E;" FontFamily="{DynamicResource IconFontFamily}" FontSize="11"
                                           Foreground="{DynamicResource SuccessBrush}" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="1" Text="只守护 DSH desktop profile：把插件清单、依赖与配置快照到本地数据目录。"
                                           Style="{StaticResource ValueText}" TextWrapping="Wrap" />
                            </Grid>
                            <Grid Margin="0,8,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="20" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="&#xE73E;" FontFamily="{DynamicResource IconFontFamily}" FontSize="11"
                                           Foreground="{DynamicResource SuccessBrush}" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="1" Text="不修改安装目录与 app.asar，不读取凭据；还原前备份现场，失败可回滚。"
                                           Style="{StaticResource ValueText}" TextWrapping="Wrap" />
                            </Grid>

                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource PaneCard}" Margin="0,0,0,10">
                        <StackPanel>
                            <Grid>
                                <TextBlock Text="自动定位" Style="{StaticResource SectionTitleText}" />
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                    <Ellipse Width="6" Height="6" VerticalAlignment="Center">
                                        <Ellipse.Style>
                                            <Style TargetType="Ellipse">
                                                <Setter Property="Fill" Value="{DynamicResource WarningBrush}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Found}" Value="True">
                                                        <Setter Property="Fill" Value="{DynamicResource SuccessBrush}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Ellipse.Style>
                                    </Ellipse>
                                    <TextBlock Text="{Binding LocationStatusText}" Margin="7,0,0,0"
                                               Style="{StaticResource HintText}" VerticalAlignment="Center" />
                                </StackPanel>
                            </Grid>

                            <Grid Margin="0,12,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="76" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="安装目录" Style="{StaticResource ValueText}" />
                                <TextBlock Grid.Column="1" Text="{Binding InstallDirText}" Style="{StaticResource LabelText}"
                                           TextTrimming="CharacterEllipsis" />
                            </Grid>
                            <Grid Margin="0,7,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="76" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="profile" Style="{StaticResource ValueText}" />
                                <TextBlock Grid.Column="1" Text="{Binding ProfileDirText}" Style="{StaticResource LabelText}"
                                           TextTrimming="CharacterEllipsis" />
                            </Grid>
                            <Grid Margin="0,7,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="76" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="版本" Style="{StaticResource ValueText}" />
                                <StackPanel Grid.Column="1" Orientation="Horizontal">
                                    <TextBlock Text="{Binding AppVersionText}" Style="{StaticResource LabelText}" />
                                    <TextBlock Text=" / " Style="{StaticResource HintText}" />
                                    <TextBlock Text="{Binding DshVersionText}" Style="{StaticResource LabelText}" />
                                </StackPanel>
                            </Grid>

                            <Border Margin="0,12,0,0" Padding="10,8" CornerRadius="10"
                                    Background="{DynamicResource WarningSoftBrush}"
                                    Visibility="{Binding NotFound, Converter={StaticResource BoolToVis}}">
                                <Grid>
                                    <TextBlock Text="未找到安装，请确认已安装 DeepSeek Harness 桌面版。" FontSize="11.5"
                                               Foreground="{DynamicResource WarningBrush}" VerticalAlignment="Center"
                                               TextWrapping="Wrap" />
                                    <Button HorizontalAlignment="Right" Command="{Binding RelocateCommand}"
                                            Style="{StaticResource SecondaryButton}" Height="28" Padding="10,0">
                                        <TextBlock Text="重新定位" FontSize="11.5" />
                                    </Button>
                                </Grid>
                            </Border>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource PaneCard}">
                        <StackPanel>
                            <TextBlock Text="选项" Style="{StaticResource SectionTitleText}" />
                            <Grid Margin="0,12,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="开机自启" Style="{StaticResource LabelText}" />
                                    <TextBlock Text="登录 Windows 后在通知区域后台运行；可随时在设置中关闭。"
                                               Style="{StaticResource RowHint}" Margin="0,3,0,0" />
                                </StackPanel>
                                <ToggleButton Grid.Column="1" Style="{StaticResource SwitchToggle}" VerticalAlignment="Center"
                                              IsChecked="{Binding Autostart, Mode=TwoWay}" />
                            </Grid>

                            <Border Style="{StaticResource Divider}" Margin="0,12,0,12" />

                            <TextBlock Text="建议立即创建一次 light 快照作为基线。之后在 DSH 更新时，Loom 会据此把插件重新织回新运行时。"
                                       Style="{StaticResource RowHint}" />

                            <Border Margin="0,10,0,0" Padding="10,8" CornerRadius="10"
                                    Visibility="{Binding HasSnapshotResult, Converter={StaticResource BoolToVis}}">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Background" Value="{DynamicResource SuccessSoftBrush}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding SnapshotSucceeded}" Value="False">
                                                <Setter Property="Background" Value="{DynamicResource DangerSoftBrush}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE73E;" FontFamily="{DynamicResource IconFontFamily}" FontSize="11"
                                               VerticalAlignment="Center" Margin="0,0,6,0">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="{DynamicResource DangerBrush}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding SnapshotSucceeded}" Value="True">
                                                        <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                    <TextBlock Text="{Binding SnapshotResultText}" FontSize="11.5" VerticalAlignment="Center"
                                               TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <Grid Grid.Row="2" Margin="26,10,26,18">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="{Binding ErrorText}" Foreground="{DynamicResource DangerBrush}" FontSize="11.5"
                               Visibility="{Binding HasError, Converter={StaticResource BoolToVis}}" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Command="{Binding LaterCommand}" Style="{StaticResource GhostButton}" Height="44" Padding="16,0">
                        <TextBlock Text="稍后再说" FontSize="12.5" />
                    </Button>
                    <Button x:Name="PrimaryActionButton" Click="OnPrimaryClick" Style="{StaticResource PrimaryButton}"
                            Height="44" Padding="22,0" Margin="8,0,0,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE722;" FontFamily="{DynamicResource IconFontFamily}" FontSize="13"
                                       VerticalAlignment="Center" />
                            <TextBlock Text="{Binding PrimaryText}" Margin="8,0,0,0" FontSize="12.5" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</UserControl>
