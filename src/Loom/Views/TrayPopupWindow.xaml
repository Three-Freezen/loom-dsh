<Window x:Class="Loom.Views.TrayPopupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:Loom.Views"
        Title="Loom"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        SizeToContent="WidthAndHeight"
        ShowInTaskbar="False"
        Topmost="True"
        FocusManager.IsFocusScope="True">
    <!-- 26px 外边距留给卡片阴影；Grid 本身不参与命中测试，点击穿透 -->
    <Grid>
        <views:TrayPopupView x:Name="Root" Margin="26" />
    </Grid>
</Window>
