<UserControl x:Class="Loom.Views.LogoMark"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Focusable="False"
             IsHitTestVisible="False"
             SnapsToDevicePixels="True">
    <!--
        LOOM 品牌标：严格按 design/icons/LOOM-icon-{light,dark}-check.svg 的几何重绘。
        SVG 为 1024 坐标系，这里按 48/1024 = 0.046875 缩放（数值保留 6 位小数），
        z 序与 SVG 一致：横条 → 蓝色 S 线 → 中层补块 → 对钩 tile → 蓝色对钩。
        颜色全部来自主题 token：深色主题 = 深底浅字形，浅色主题 = 浅底深字形；
        蓝色 S 线/对钩两套主题都用品牌蓝 LogoLineBrush（与托盘 ico 完全一致）。
        说明：SVG 里 1/1024 的描边缩到 48 后约 0.047px 不可见，tile 描边按最小可见 0.5px 绘制。
    -->
    <Viewbox Stretch="Uniform">
        <Canvas Width="48" Height="48">
            <!-- tile: x=32 y=32 w=960 h=960 rx=211.2（渐变 + 1/1024 细边） -->
            <Rectangle Canvas.Left="1.5" Canvas.Top="1.5" Width="45" Height="45"
                       RadiusX="9.9" RadiusY="9.9"
                       Fill="{DynamicResource LogoTileGradientBrush}"
                       Stroke="{DynamicResource LogoTileBorderBrush}"
                       StrokeThickness="0.5" />

            <!-- 三条横条：y=267.3125 / 383.5625 / 499.8125，h=65.625 rx=32.8125 -->
            <Rectangle Canvas.Left="14.332031" Canvas.Top="12.530273" Width="19.335938" Height="3.076172"
                       RadiusX="1.538086" RadiusY="1.538086" Fill="{DynamicResource LogoGlyphBrush}" />
            <Rectangle Canvas.Left="16.089844" Canvas.Top="17.979492" Width="15.820313" Height="3.076172"
                       RadiusX="1.538086" RadiusY="1.538086" Fill="{DynamicResource LogoGlyphBrush}" />
            <Rectangle Canvas.Left="17.847656" Canvas.Top="23.428711" Width="12.304688" Height="3.076172"
                       RadiusX="1.538086" RadiusY="1.538086" Fill="{DynamicResource LogoGlyphBrush}" />

            <!-- 蓝色 S 线（贯穿三条横条，stroke-width 46.875，圆头） -->
            <Path Data="M 24,12.53025 C 16.265625,19.605469 31.734375,26.109375 24,30.547875"
                  Stroke="{DynamicResource LogoLineBrush}"
                  StrokeThickness="2.197266"
                  StrokeStartLineCap="Round"
                  StrokeEndLineCap="Round" />

            <!-- 中层补块：x=420.125 y=383.5625 w=183.75 h=65.625（无圆角，压在 S 线上） -->
            <Rectangle Canvas.Left="19.693359" Canvas.Top="17.979492" Width="8.613281" Height="3.076172"
                       Fill="{DynamicResource LogoGlyphBrush}" />

            <!-- 对钩 tile：x=450.125 y=632.9375 w=123.75 h=123.75 rx=33.75 -->
            <Rectangle Canvas.Left="21.099609" Canvas.Top="29.668945" Width="5.800781" Height="5.800781"
                       RadiusX="1.582031" RadiusY="1.582031" Fill="{DynamicResource LogoGlyphBrush}" />

            <!-- 蓝色对钩：stroke-width 16.875（SVG 里对钩就是品牌蓝，不是 tile 底色） -->
            <Path Data="M 22.505859,32.4375 L 23.648438,33.580078 L 25.757813,31.470703"
                  Stroke="{DynamicResource LogoLineBrush}"
                  StrokeThickness="0.791016"
                  StrokeStartLineCap="Round"
                  StrokeEndLineCap="Round"
                  StrokeLineJoin="Round" />
        </Canvas>
    </Viewbox>
</UserControl>
