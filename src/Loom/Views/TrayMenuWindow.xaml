<Window x:Class="Loom.Views.TrayMenuWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:Loom.Views"
        Title="Loom"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        SizeToContent="WidthAndHeight"
        ShowInTaskbar="False"
        Topmost="True"
        FocusManager.IsFocusScope="True">
    <!-- 20px 外边距留给卡片阴影；窗口本身透明、点击菜单外即失焦关闭 -->
    <Grid>
        <views:TrayMenuView x:Name="Root" Margin="20" />
    </Grid>
</Window>
