<UserControl x:Class="Loom.Views.TrayPopupView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:Loom.Views"
             Width="360"
             FontFamily="{DynamicResource UiFontFamily}"
             FontSize="12.5"
             Foreground="{DynamicResource TextSecondaryBrush}"
             SnapsToDevicePixels="True"
             TextOptions.TextFormattingMode="Display">

    <!-- 弹层视为一张卡片；窗口本体透明，渲染时由外部画页面底色即可看到圆角与阴影 -->
    <Border x:Name="Card"
            Background="{DynamicResource L1Brush}"
            BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="1"
            CornerRadius="18">
        <Border.Effect>
            <DropShadowEffect BlurRadius="28" Color="#000000" Direction="270" Opacity="0.42" ShadowDepth="0" />
        </Border.Effect>
        

        <StackPanel Margin="18,16,18,16">

            <!-- 头部：品牌 + 状态胶囊 -->
            <Grid>
                <StackPanel Orientation="Horizontal">
                    <views:LogoMark Width="30" Height="30" VerticalAlignment="Center" />
                    <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                        <TextBlock Style="{StaticResource BrandText}" Text="LOOM" />
                        <TextBlock Style="{StaticResource HintText}" Text="DSH 插件守护" Margin="0,1,0,0" />
                    </StackPanel>
                </StackPanel>

                <Border HorizontalAlignment="Right" VerticalAlignment="Center" CornerRadius="20" Padding="9,3">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Background" Value="{DynamicResource L2Brush}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding StatusKey}" Value="Normal">
                                    <Setter Property="Background" Value="{DynamicResource SuccessSoftBrush}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding StatusKey}" Value="Busy">
                                    <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding StatusKey}" Value="AwaitingExit">
                                    <Setter Property="Background" Value="{DynamicResource WarningSoftBrush}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding StatusKey}" Value="NeedsManual">
                                    <Setter Property="Background" Value="{DynamicResource WarningSoftBrush}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding StatusKey}" Value="Failed">
                                    <Setter Property="Background" Value="{DynamicResource DangerSoftBrush}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <StackPanel Orientation="Horizontal">
                        <Ellipse Width="6" Height="6" VerticalAlignment="Center">
                            <Ellipse.Style>
                                <Style TargetType="Ellipse">
                                    <Setter Property="Fill" Value="{DynamicResource TextQuaternaryBrush}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding StatusKey}" Value="Normal">
                                            <Setter Property="Fill" Value="{DynamicResource SuccessBrush}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding StatusKey}" Value="Busy">
                                            <Setter Property="Fill" Value="{DynamicResource AccentBrush}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding StatusKey}" Value="AwaitingExit">
                                            <Setter Property="Fill" Value="{DynamicResource WarningBrush}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding StatusKey}" Value="NeedsManual">
                                            <Setter Property="Fill" Value="{DynamicResource WarningBrush}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding StatusKey}" Value="Failed">
                                            <Setter Property="Fill" Value="{DynamicResource DangerBrush}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Ellipse.Style>
                        </Ellipse>
                        <TextBlock Text="{Binding StatusLabel}" Margin="6,0,0,0" FontSize="11" VerticalAlignment="Center" />
                    </StackPanel>
                </Border>
            </Grid>

            <!-- 状态卡 -->
            <Border Style="{StaticResource InsetCard}" Margin="0,16,0,0">
                <StackPanel>
                    <Grid>
                        <TextBlock Text="DeepSeek Harness" Style="{StaticResource LabelText}" FontSize="13" />
                        <TextBlock Text="{Binding VersionText}" HorizontalAlignment="Right" Style="{StaticResource SubText}" />
                    </Grid>
                    <StackPanel Orientation="Horizontal" Margin="0,9,0,0">
                        <TextBlock Text="&#xE73E;" FontFamily="{DynamicResource IconFontFamily}" FontSize="11"
                                   Foreground="{DynamicResource SuccessBrush}" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding ProtectedText}" Margin="7,0,0,0" Style="{StaticResource ValueText}" />
                    </StackPanel>
                    <TextBlock Text="{Binding SnapshotText}" Margin="0,3,0,0" Style="{StaticResource HintText}"
                               TextTrimming="CharacterEllipsis" />
                    <Border Style="{StaticResource Divider}" Margin="0,11,0,9" />
                    <Grid>
                        <TextBlock Text="{Binding UsageText}" Style="{StaticResource SubText}" />
                        <TextBlock Text="{Binding FrequencyText}" HorizontalAlignment="Right" Style="{StaticResource SubText}" />
                    </Grid>
                </StackPanel>
            </Border>

            <!-- 主按钮 -->
            <Button Height="44" Margin="0,14,0,0" Command="{Binding SnapshotCommand}" Style="{StaticResource PrimaryButton}"
                    ToolTip="采集当前 profile 的插件清单与配置，写入本地快照目录">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <TextBlock Text="&#xE722;" FontFamily="{DynamicResource IconFontFamily}" FontSize="14"
                               VerticalAlignment="Center" />
                    <TextBlock Text="{Binding PrimaryText}" Margin="8,0,0,0" FontSize="13" VerticalAlignment="Center" />
                </StackPanel>
            </Button>

            <ProgressBar Style="{StaticResource LoomProgressBar}" IsIndeterminate="True" Height="3" Margin="0,8,0,0"
                         Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}" />

            <!-- 次级动作 -->
            <Grid Margin="0,10,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="10" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Button Grid.Column="0" Height="38" Command="{Binding CheckCommand}" Style="{StaticResource SecondaryButton}">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <TextBlock Text="&#xE895;" FontFamily="{DynamicResource IconFontFamily}" FontSize="12"
                                   VerticalAlignment="Center" />
                        <TextBlock Text="检查兼容性" Margin="7,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
                <Button Grid.Column="2" Height="38" Command="{Binding BackupFolderCommand}" Style="{StaticResource SecondaryButton}">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <TextBlock Text="&#xE8DA;" FontFamily="{DynamicResource IconFontFamily}" FontSize="12"
                                   VerticalAlignment="Center" />
                        <TextBlock Text="打开备份目录" Margin="7,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
            </Grid>

            <!-- 操作反馈 -->
            <Border Margin="0,10,0,0" CornerRadius="10" Padding="10,8"
                    Visibility="{Binding HasFeedback, Converter={StaticResource BoolToVis}}">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Background" Value="{DynamicResource L2Brush}" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding FeedbackIsError}" Value="True">
                                <Setter Property="Background" Value="{DynamicResource DangerSoftBrush}" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <TextBlock Text="{Binding FeedbackText}" TextWrapping="Wrap" FontSize="11.5">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding FeedbackIsError}" Value="True">
                                    <Setter Property="Foreground" Value="{DynamicResource DangerBrush}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </Border>

            <!-- 异常 / 人工介入面板 -->
            <Border Margin="0,12,0,0" CornerRadius="12" Padding="12"
                    Background="{DynamicResource WarningSoftBrush}"
                    Visibility="{Binding ShowIssuePanel, Converter={StaticResource BoolToVis}}">
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE7BA;" FontFamily="{DynamicResource IconFontFamily}" FontSize="14"
                                   Foreground="{DynamicResource WarningBrush}" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding IssueTitle}" Margin="8,0,0,0" FontSize="12.5" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextPrimaryBrush}" TextWrapping="Wrap" />
                    </StackPanel>
                    <TextBlock Text="{Binding IssueDetail}" Margin="0,5,0,0" Style="{StaticResource SubText}"
                               TextWrapping="Wrap" />
                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                        <Button Height="32" Padding="12,0" Command="{Binding RetryCommand}"
                                Style="{StaticResource SecondaryButton}">
                            <TextBlock Text="{Binding RetryText}" FontSize="12" />
                        </Button>
                        <Button Height="32" Padding="12,0" Margin="8,0,0,0" Command="{Binding RollbackCommand}"
                                Style="{StaticResource SecondaryButton}"
                                Visibility="{Binding ShowRollback, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="回滚" FontSize="12" />
                        </Button>
                        <Button Height="32" Padding="12,0" Margin="8,0,0,0" Command="{Binding ReportCommand}"
                                Style="{StaticResource GhostButton}">
                            <TextBlock Text="打开报告" FontSize="12" />
                        </Button>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- 首次运行提示 -->
            <Border Margin="0,12,0,0" CornerRadius="12" Padding="12,9"
                    Background="{DynamicResource L2Brush}"
                    Visibility="{Binding ShowFirstRunHint, Converter={StaticResource BoolToVis}}">
                <Grid>
                    <TextBlock Text="尚未完成首次设置" Style="{StaticResource SubText}" VerticalAlignment="Center" />
                    <Button HorizontalAlignment="Right" Command="{Binding FirstRunCommand}" Style="{StaticResource LinkButton}">
                        <TextBlock Text="打开向导" FontSize="11.5" />
                    </Button>
                </Grid>
            </Border>

            <!-- 最近活动 -->
            <Grid Margin="0,16,0,0">
                <TextBlock Text="最近活动" Style="{StaticResource SectionTitleText}" FontSize="12.5" />
                <Button HorizontalAlignment="Right" Command="{Binding ReportCommand}" Style="{StaticResource LinkButton}">
                    <TextBlock Text="全部" FontSize="11.5" />
                </Button>
            </Grid>

            <ItemsControl ItemsSource="{Binding Activity}" Margin="0,4,0,0">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Grid Margin="0,5">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="22" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Border Width="19" Height="19" CornerRadius="10" Background="{DynamicResource L2Brush}"
                                    VerticalAlignment="Center">
                                <TextBlock Text="{Binding Glyph}" FontFamily="{DynamicResource IconFontFamily}" FontSize="10"
                                           HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="{DynamicResource TextTertiaryBrush}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Kind}" Value="ok">
                                                    <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Kind}" Value="warn">
                                                    <Setter Property="Foreground" Value="{DynamicResource WarningBrush}" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Kind}" Value="error">
                                                    <Setter Property="Foreground" Value="{DynamicResource DangerBrush}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Border>
                            <StackPanel Grid.Column="1" Margin="8,0,10,0" VerticalAlignment="Center">
                                <TextBlock Text="{Binding Title}" FontSize="12" Foreground="{DynamicResource TextPrimaryBrush}"
                                           TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{Binding Detail}" FontSize="10.5" Foreground="{DynamicResource TextTertiaryBrush}"
                                           TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                            <TextBlock Grid.Column="2" Text="{Binding TimeText}" Style="{StaticResource HintText}"
                                       VerticalAlignment="Center" />
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <TextBlock Text="暂无活动记录" Margin="0,6,0,0">
                <TextBlock.Style>
                    <Style TargetType="TextBlock" BasedOn="{StaticResource HintText}">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding HasActivity}" Value="False">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>

            <Border Style="{StaticResource Divider}" Margin="0,12,0,0" />

            <!-- 底部 -->
            <Grid Margin="0,9,0,0">
                <Button HorizontalAlignment="Left" Command="{Binding ReportCommand}" Style="{StaticResource LinkButton}"
                        VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE7C3;" FontFamily="{DynamicResource IconFontFamily}" FontSize="12"
                                   VerticalAlignment="Center" Foreground="{DynamicResource AccentBrush}" />
                        <TextBlock Text="查看报告" Margin="6,0,0,0" FontSize="11.5" />
                    </StackPanel>
                </Button>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Command="{Binding BackupFolderCommand}" Style="{StaticResource IconButton}" ToolTip="打开备份目录">
                        <TextBlock Text="&#xE8DA;" FontFamily="{DynamicResource IconFontFamily}" FontSize="13"
                                   HorizontalAlignment="Center" Foreground="{DynamicResource TextTertiaryBrush}" />
                    </Button>
                    <Button Command="{Binding ToggleThemeCommand}" Style="{StaticResource IconButton}" ToolTip="切换深/浅主题">
                        <TextBlock Text="{Binding ThemeGlyph}" FontFamily="{DynamicResource IconFontFamily}" FontSize="13"
                                   HorizontalAlignment="Center" Foreground="{DynamicResource TextTertiaryBrush}" />
                    </Button>
                    <Button Command="{Binding SettingsCommand}" Style="{StaticResource IconButton}" ToolTip="设置">
                        <TextBlock Text="&#xE713;" FontFamily="{DynamicResource IconFontFamily}" FontSize="13"
                                   HorizontalAlignment="Center" Foreground="{DynamicResource TextTertiaryBrush}" />
                    </Button>
                    <Button Command="{Binding ExitCommand}" Style="{StaticResource IconButton}" ToolTip="退出 Loom">
                        <TextBlock Text="&#xE7E8;" FontFamily="{DynamicResource IconFontFamily}" FontSize="13"
                                   HorizontalAlignment="Center" Foreground="{DynamicResource TextTertiaryBrush}" />
                    </Button>
                </StackPanel>
            </Grid>

            <TextBlock Text="{Binding FooterText}" Style="{StaticResource HintText}" Margin="0,8,0,0" FontSize="10.5" />
        </StackPanel>
    </Border>
</UserControl>
