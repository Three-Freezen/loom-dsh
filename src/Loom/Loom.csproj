<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <RootNamespace>Loom</RootNamespace>
    <AssemblyName>loom-dsh</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <StartupObject>Loom.Program</StartupObject>
    <ApplicationIcon>Assets\Icons\loom-check-light.ico</ApplicationIcon>
    <Platforms>AnyCPU;x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <Description>Loom for DSH - tray guard + CLI for DSH plugin recovery.</Description>
    <AssemblyTitle>Loom for DSH</AssemblyTitle>
    <Product>Loom for DSH</Product>
    <Version>0.1.1</Version>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Loom.Core\Loom.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- helper.mjs runs under the installed DSH Electron Node; embedded and extracted at runtime. -->
    <EmbeddedResource Include="Assets\helper.mjs" LogicalName="Loom.helper.mjs" />
    <EmbeddedResource Include="Assets\Icons\loom-check-light.ico" LogicalName="Loom.Icons.light.ico" />
    <EmbeddedResource Include="Assets\Icons\loom-check-dark.ico" LogicalName="Loom.Icons.dark.ico" />
  </ItemGroup>

  <ItemGroup>
    <None Update="Assets\Icons\loom-check-light.ico" CopyToOutputDirectory="PreserveNewest" />
    <None Update="Assets\Icons\loom-check-dark.ico" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
