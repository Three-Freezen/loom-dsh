<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- LOOM light tokens · 对齐 DSH 0.2.2-rc.1 app.asar 实测值（docs/命名与设计说明.md 第三节） -->

    <!-- 基础层 -->
    <SolidColorBrush x:Key="BgBrush" Color="#f2f4f7" />
    <SolidColorBrush x:Key="L1Brush" Color="#ffffff" />
    <SolidColorBrush x:Key="L2Brush" Color="#f7f8fa" />
    <SolidColorBrush x:Key="L3Brush" Color="#eceef2" />
    <SolidColorBrush x:Key="SidebarBrush" Color="#f0f2f5" />

    <!-- 文字 -->
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="#0f1115" />
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#61666b" />
    <SolidColorBrush x:Key="TextTertiaryBrush" Color="#81858c" />
    <SolidColorBrush x:Key="TextQuaternaryBrush" Color="#9aa0a6" />

    <!-- 状态 -->
    <SolidColorBrush x:Key="AccentBrush" Color="#4176e6" />
    <SolidColorBrush x:Key="AccentSoftBrush" Color="#1f4176e6" />
    <SolidColorBrush x:Key="SuccessBrush" Color="#22c55e" />
    <SolidColorBrush x:Key="SuccessSoftBrush" Color="#1f22c55e" />
    <SolidColorBrush x:Key="WarningBrush" Color="#f59e0b" />
    <SolidColorBrush x:Key="WarningSoftBrush" Color="#22f59e0b" />
    <SolidColorBrush x:Key="DangerBrush" Color="#ef4444" />
    <SolidColorBrush x:Key="DangerSoftBrush" Color="#1fef4444" />

    <!-- 描边 / 交互 -->
    <SolidColorBrush x:Key="BorderBrush" Color="#e4e7ec" />
    <SolidColorBrush x:Key="BorderStrongBrush" Color="#d4d9e1" />
    <SolidColorBrush x:Key="HoverBrush" Color="#08000000" />
    <SolidColorBrush x:Key="PressedBrush" Color="#12000000" />
    <SolidColorBrush x:Key="InputBgBrush" Color="#f7f8fa" />
    <SolidColorBrush x:Key="SelectedNavBrush" Color="#e6eaf1" />

    <!-- 主/次按钮（浅色：黑底白字） -->
    <SolidColorBrush x:Key="ButtonPrimaryBgBrush" Color="#121317" />
    <SolidColorBrush x:Key="ButtonPrimaryTextBrush" Color="#ffffff" />
    <SolidColorBrush x:Key="ButtonPrimaryHoverBrush" Color="#24262c" />
    <SolidColorBrush x:Key="ButtonSecondaryBgBrush" Color="#ffffff" />
    <SolidColorBrush x:Key="ButtonSecondaryTextBrush" Color="#0f1115" />
    <SolidColorBrush x:Key="ButtonSecondaryHoverBrush" Color="#f3f5f8" />

    <!-- Toast / 提示 -->
    <SolidColorBrush x:Key="ToastBrush" Color="#43454a" />
    <SolidColorBrush x:Key="ToastTextBrush" Color="#ffffff" />
    <SolidColorBrush x:Key="TooltipBgBrush" Color="#43454a" />
    <SolidColorBrush x:Key="TooltipTextBrush" Color="#ffffff" />

    <!-- 品牌 / 图标（浅色主题 = 浅底深字形，与 loom-check-light.ico 同一几何/配色） -->
    <LinearGradientBrush x:Key="LogoTileGradientBrush" StartPoint="0.8536,0.1464" EndPoint="0.1464,0.8536">
        <GradientStop Color="#ffffff" Offset="0" />
        <GradientStop Color="#f7f8fa" Offset="0.55" />
        <GradientStop Color="#e9ecf2" Offset="1" />
    </LinearGradientBrush>
    <SolidColorBrush x:Key="LogoTileBrush" Color="#ffffff" />
    <SolidColorBrush x:Key="LogoGlyphBrush" Color="#191a1d" />
    <SolidColorBrush x:Key="LogoLineBrush" Color="#4176e6" />
    <SolidColorBrush x:Key="LogoTileBorderBrush" Color="#0f0f1115" />

    <!-- 托盘右键菜单（WPF 自绘，跟随应用主题） -->
    <SolidColorBrush x:Key="MenuSurfaceBrush" Color="#ffffff" />
    <SolidColorBrush x:Key="MenuBorderBrush" Color="#e4e7ec" />
    <SolidColorBrush x:Key="MenuHoverBrush" Color="#f0f2f6" />
    <SolidColorBrush x:Key="MenuPressedBrush" Color="#e6e9ef" />
    <SolidColorBrush x:Key="MenuTextBrush" Color="#0f1115" />
    <SolidColorBrush x:Key="MenuTextDisabledBrush" Color="#b3b8be" />
    <SolidColorBrush x:Key="MenuIconBrush" Color="#61666b" />
    <SolidColorBrush x:Key="MenuSeparatorBrush" Color="#e6e9ee" />
    <SolidColorBrush x:Key="MenuDangerBrush" Color="#c94a4a" />

    <!-- 滚动条 -->
    <SolidColorBrush x:Key="ScrollThumbBrush" Color="#26000000" />
    <SolidColorBrush x:Key="ScrollThumbHoverBrush" Color="#45000000" />
    <SolidColorBrush x:Key="ScrollTrackBrush" Color="#00000000" />

    <!-- 阴影 -->
    <Color x:Key="ShadowColor">#3a4250</Color>
</ResourceDictionary>
